# Direct local execution reads process environment, not this file automatically.
# Docker Compose reads .env for interpolation. Copy and edit locally; do not commit .env.
AUCTION_DB_PATH=data/auction.sqlite3
AUCTION_FRONTEND_DIR=frontend/dist
AUCTION_COOKIE_SECURE=false
AUCTION_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Optional direct PostgreSQL connection; overrides AUCTION_DB_PATH when non-empty.
# Percent-encode special characters in URL credentials.
# AUCTION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Required only for compose.postgres.yaml. No default password is supplied.
# Use a generated URL-safe value, for example the output of `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# No LLM provider key is needed for v0.
